<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yeathey food Stall Feedback</title>
    <style>
        :root {
            --primary-color: #ff6b6b;
            --secondary-color: #4ecdc4;
            --dark-color: #2f2f2f;
            --light-color: #f7f9fa;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--light-color);
            color: var(--dark-color);
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .feedback-card {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            width: 100%;
            max-width: 500px;
        }

        .header {
            text-align: center;
            margin-bottom: 25px;
        }

        .header h1 {
            color: var(--primary-color);
            font-size: 24px;
            margin-bottom: 8px;
        }

        .header p {
            color: #777;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 14px;
        }

        input[type="text"], select, textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid #e1e1e1;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.3s;
        }

        input[type="text"]:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        /* Rating Stars styling */
        .rating-container {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
            gap: 10px;
        }

        .rating-container input {
            display: none;
        }

        .rating-container label {
            cursor: pointer;
            font-size: 30px;
            color: #e1e1e1;
            transition: color 0.2s;
            margin-bottom: 0;
        }

        .rating-container input:checked ~ label,
        .rating-container label:hover,
        .rating-container label:hover ~ label {
            color: #ffca28;
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        button {
            width: 100%;
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }

        button:hover {
            background-color: #ff5252;
        }

        .thank-you-msg {
            display: none;
            text-align: center;
            padding: 40px 20px;
        }

        .thank-you-msg h2 {
            color: var(--secondary-color);
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

    <div class="feedback-card">
        <!-- The Form -->
        <form id="feedbackForm">
            <div class="header">
                <h1>Yaethey MMu Food Stall</h1>
                <p>We’d love to hear your thoughts! Help us improve.</p>
            </div>

            <!-- Name (Optional) -->
            <div class="form-group">
                <label for="customerName">Un Pere Punde (Pode Da Punde)</label>
                <input type="text" id="customerName" placeholder="Dolat Pure .Punde">
            </div>

            <!-- Dish Ordered -->
            <div class="form-group">
                <label for="foodItem">Yenna Punde Eh Saapete?</label>
                <select id="foodItem" required>
                    <option value="" disabled selected>Select a dish...</option>
                    <option value="signature-noodles">Signature Koli Kunji</option>
                    <option value="fried-rice">Spicy Nai Kunji</option>
                    <option value="chicken-satay">Koli Sakila</option>
                    <option value="other">Vere Yenna Punde!</option>
                </select>
            </div>

            <!-- Star Rating -->
            <div class="form-group">
                <label>100% kude da junni?</label>
                <div class="rating-container">
                    <input type="radio" name="rating" id="star5" value="5" required><label for="star5">★</label>
                    <input type="radio" name="rating" id="star4" value="4"><label for="star4">★</label>
                    <input type="radio" name="rating" id="star3" value="3"><label for="star3">★</label>
                    <input type="radio" name="rating" id="star2" value="2"><label for="star2">★</label>
                    <input type="radio" name="rating" id="star1" value="1"><label for="star1">★</label>
                </div>
            </div>

            <!-- Comments -->
            <div class="form-group">
                <label for="comments">Your Opinion / Suggestions</label>
                <textarea id="comments" placeholder="Tell us what you liked or how we can improve...Yenna punde eh sonalum naa seye maaten" required></textarea>
            </div>

            <button type="submit">Submit Feedback</button>
        </form>

        <!-- Success Message -->
        <div id="Umbe daa" class="thank-you-msg">
            <h2>Umbenal Valtukal! 🌟</h2>
            <p>Your feedback has been received.Suute eh moodite kelambu!</p>
        </div>
    </div>

    <script>
        document.getElementById('feedbackForm').addEventListener('submit', function(e) {
            e.preventDefault(); // Prevents page reload
            
            // Collect the data
            const name = document.getElementById('customerName').value || 'Anonymous';
            const food = document.getElementById('foodItem').value;
            const rating = document.querySelector('input[name="rating"]:checked').value;
            const comments = document.getElementById('comments').value;

            // Log to console for testing
            console.log("Feedback Received:", { name, food, rating, comments });

            // Hide form and show thank you message
            document.getElementById('feedbackForm').style.display = 'none';
            document.getElementById('thankYouMessage').style.display = 'block';

            // TODO: Connect this to a backend database or Google Sheets to save data permanently.
        });
    </script>
</body>
</html>